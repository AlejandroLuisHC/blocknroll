# SMTP Config
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_TO=

# Server-only Vercel Global Config connection. Vercel sets this when the store is connected.
GLOBAL_CONFIG=

# Public
VITE_CONTACT_ENDPOINT=
# Production origin. Update when moving to a custom domain.
VITE_SITE_URL=https://blocknroll.vercel.app
# Optional Google Search Console HTML verification token (public).
VITE_GOOGLE_SITE_VERIFICATION=
# Set true for a staging build. Vercel preview builds set noindex automatically.
VITE_NOINDEX=false
